---
const CONTACT_WHATSAPP = import.meta.env.PUBLIC_WHATSAPP || 'https://wa.me/50688888888';
const CONTACT_EMAIL = import.meta.env.PUBLIC_CONTACT_EMAIL || 'info@vamosjacotours.com';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#dc3522" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Site Unavailable | Vamos Jacó Tours</title>
		<meta
			name="description"
			content="Vamos Jacó Tours website is no longer available."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}
			:root {
				--brand-red: #dc3522;
				--brand-red-dark: #b02113;
				--brand-teal: #03a696;
				--text: #1f2937;
				--muted: #6b7280;
			}
			body {
				font-family: "Poppins", system-ui, -apple-system, sans-serif;
				background: radial-gradient(circle at top, #fff5f2 0%, #ffffff 55%);
				color: var(--text);
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 2rem;
				line-height: 1.6;
			}
			.card {
				text-align: center;
				max-width: 560px;
				width: 100%;
			}
			.logo {
				width: 120px;
				height: auto;
				margin: 0 auto 2rem;
				display: block;
			}
			.status-badge {
				display: inline-flex;
				align-items: center;
				gap: 0.6rem;
				padding: 0.45rem 1.1rem;
				border-radius: 999px;
				background: #fff;
				border: 1px solid #fecaca;
				color: var(--brand-red-dark);
				font-size: 0.85rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				margin-bottom: 1.75rem;
			}
			.dot {
				width: 10px;
				height: 10px;
				border-radius: 50%;
				background: var(--brand-red);
				animation: pulse 1.4s ease-in-out infinite;
			}
			@keyframes pulse {
				0%, 100% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.4; transform: scale(0.75); }
			}
			.error-code {
				font-size: clamp(4rem, 12vw, 7rem);
				font-weight: 900;
				letter-spacing: -0.04em;
				line-height: 1;
				margin-bottom: 1rem;
				color: var(--brand-red);
				opacity: 0.15;
			}
			h1 {
				font-size: clamp(1.6rem, 4vw, 2.2rem);
				font-weight: 800;
				letter-spacing: -0.02em;
				margin-bottom: 1rem;
				color: #111827;
			}
			h1 span {
				color: var(--brand-red);
			}
			p {
				color: var(--muted);
				font-size: 1rem;
				margin-bottom: 1rem;
			}
			.note {
				font-size: 0.9rem;
				color: #9ca3af;
				font-style: italic;
				margin-bottom: 1.5rem;
			}
			.footer {
				margin-top: 2.5rem;
				font-size: 0.8rem;
				color: #9ca3af;
			}
			.divider {
				width: 60px;
				height: 2px;
				background: linear-gradient(90deg, transparent, var(--brand-red), transparent);
				margin: 1.5rem auto;
			}
			@media (prefers-color-scheme: dark) {
				body {
					background: radial-gradient(circle at top, #1a1110 0%, #0b0b0e 55%);
					color: #e5e7eb;
				}
				h1 { color: #f9fafb; }
				p { color: #9ca3af; }
				.status-badge {
					background: #1f1f24;
					border-color: #3f2422;
				}
			}
		</style>
	</head>
	<body>
		<div class="card">
			<img
				src="/logo.png"
				alt="Vamos Jacó Tours"
				class="logo"
				width="120"
				height="120"
			/>
			<div class="error-code">404</div>
			<div class="status-badge">
				<span class="dot"></span>
				<span>Out of Service</span>
			</div>
			<h1>This site is <span>no longer available</span></h1>
			<div class="divider"></div>
			<p>
				The website for Vamos Jacó Tours has been discontinued and is no longer in operation.
			</p>
			<p class="note">
				El sitio web de Vamos Jacó Tours ha sido descontinuado y ya no se encuentra disponible.
			</p>
			<p class="footer">© {new Date().getFullYear()} Vamos Jacó Tours · Jacó, Costa Rica</p>
		</div>
	</body>
</html>
