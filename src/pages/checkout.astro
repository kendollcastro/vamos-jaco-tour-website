---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Checkout | Vamos Jacó Tours"
    description="Complete your booking with Vamos Jacó Tours. Secure payment processing."
    robots="noindex, nofollow"
>
    <div class="min-h-screen bg-dark pt-32 pb-20">
        <div class="max-w-4xl mx-auto px-6">
            <h1
                class="text-4xl md:text-5xl font-black text-white mb-8 border-b border-white/10 pb-6"
            >
                Checkout
            </h1>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Left: Booking Summary -->
                <div class="md:col-span-2 space-y-8">
                    <!-- Guest Details Form -->
                    <div
                        class="bg-dark-soft rounded-2xl border border-white/10 p-6 md:p-8"
                    >
                        <h2
                            class="text-xl font-bold text-white mb-6 flex items-center gap-3"
                        >
                            <span
                                class="w-8 h-8 rounded-full bg-primary/20 text-primary flex items-center justify-center text-sm font-bold"
                                >1</span
                            >
                            Your Details
                        </h2>
                        <form class="space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label
                                        class="block text-sm text-gray-400 mb-1"
                                        >First Name</label
                                    >
                                    <input
                                        type="text"
                                        class="w-full bg-dark border border-white/10 rounded-lg px-4 py-3 text-white focus:border-primary focus:outline-none"
                                        placeholder="John"
                                    />
                                </div>
                                <div>
                                    <label
                                        class="block text-sm text-gray-400 mb-1"
                                        >Last Name</label
                                    >
                                    <input
                                        type="text"
                                        class="w-full bg-dark border border-white/10 rounded-lg px-4 py-3 text-white focus:border-primary focus:outline-none"
                                        placeholder="Doe"
                                    />
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm text-gray-400 mb-1"
                                    >Email Address</label
                                >
                                <input
                                    type="email"
                                    class="w-full bg-dark border border-white/10 rounded-lg px-4 py-3 text-white focus:border-primary focus:outline-none"
                                    placeholder="john@example.com"
                                />
                            </div>
                            <div>
                                <label class="block text-sm text-gray-400 mb-1"
                                    >Phone Number (WhatsApp)</label
                                >
                                <input
                                    type="tel"
                                    class="w-full bg-dark border border-white/10 rounded-lg px-4 py-3 text-white focus:border-primary focus:outline-none"
                                    placeholder="+1 (555) 000-0000"
                                />
                            </div>
                        </form>
                    </div>

                    <!-- Payment Method -->
                    <div
                        class="bg-dark-soft rounded-2xl border border-white/10 p-6 md:p-8"
                    >
                        <h2
                            class="text-xl font-bold text-white mb-6 flex items-center gap-3"
                        >
                            <span
                                class="w-8 h-8 rounded-full bg-primary/20 text-primary flex items-center justify-center text-sm font-bold"
                                >2</span
                            >
                            Payment Method
                        </h2>

                        <div class="space-y-4">
                            <!-- TiloPay -->
                            <div
                                id="tilopay-option"
                                class="bg-white/5 rounded-xl p-4 border border-primary/30 flex items-center gap-4 cursor-pointer hover:bg-white/10 transition-all"
                            >
                                <div
                                    class="w-12 h-12 bg-white rounded-lg flex items-center justify-center p-1"
                                >
                                    <img
                                        src="/images/tilopay-logo-placeholder.png"
                                        alt="TiloPay"
                                        class="object-contain"
                                        onerror="this.src='https://placehold.co/100x100/white/black?text=TiloPay'"
                                    />
                                </div>
                                <div>
                                    <h4 class="text-white font-bold">
                                        Credit / Debit Card
                                    </h4>
                                    <p class="text-xs text-gray-400">
                                        Secure payment via TiloPay
                                    </p>
                                </div>
                                <div class="ml-auto">
                                    <div
                                        class="w-5 h-5 rounded-full border-4 border-primary bg-white payment-radio shadow-[0_0_10px_rgba(255,87,34,0.3)]"
                                        data-method="card"
                                    >
                                    </div>
                                </div>
                            </div>

                            <!-- WhatsApp/Cash Option -->
                            <div
                                id="cash-option"
                                class="bg-white/5 rounded-xl p-4 border border-white/10 flex items-center gap-4 cursor-pointer hover:bg-white/10 transition-all"
                            >
                                <div
                                    class="w-12 h-12 bg-green-500 rounded-lg flex items-center justify-center"
                                >
                                    <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.067 2.875 1.215 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72 1.031 3.704 1.577 5.72 1.577h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                                </div>
                                <div>
                                    <h4 class="text-white font-bold">
                                        Book with Messenger/WhatsApp
                                    </h4>
                                    <p class="text-xs text-gray-400">
                                        Confirm now, pay on site
                                    </p>
                                </div>
                                <div class="ml-auto">
                                    <div
                                        class="w-5 h-5 rounded-full border-2 border-white/20 payment-radio"
                                        data-method="cash"
                                    >
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Order Summary -->
                <div class="md:col-span-1">
                    <div
                        class="bg-dark-soft rounded-2xl border border-white/10 p-6 sticky top-28"
                    >
                        <h3 class="text-lg font-bold text-white mb-4">
                            Order Summary
                        </h3>

                        <!-- Dynamic Content Placeholder (Client-side populated) -->
                        <div id="order-summary-content" class="space-y-4 mb-6">
                            <div
                                class="skeleton h-4 w-3/4 bg-white/10 rounded animate-pulse"
                            >
                            </div>
                            <div
                                class="skeleton h-4 w-1/2 bg-white/10 rounded animate-pulse"
                            >
                            </div>
                        </div>

                        <div class="border-t border-white/10 pt-4 mb-6">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-gray-400">Subtotal</span>
                                <span
                                    class="text-white font-medium"
                                    id="summary-subtotal">--</span
                                >
                            </div>
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-gray-400">Taxes</span>
                                <span class="text-white font-medium">$0.00</span
                                >
                            </div>
                            <div
                                class="flex justify-between items-center pt-2 border-t border-white/10 mt-2"
                            >
                                <span class="text-white font-bold text-lg"
                                    >Total</span
                                >
                                <span
                                    class="text-brand-orange font-black text-2xl"
                                    id="summary-total">--</span
                                >
                            </div>
                        </div>

                        <div id="mobile-checkout-summary" class="md:hidden sticky bottom-4 left-0 right-0 z-50 px-2 pointer-events-none">
                            <div class="bg-primary/95 backdrop-blur-md rounded-2xl p-3 shadow-2xl border border-white/20 flex items-center gap-3 pointer-events-auto">
                                <div class="min-w-[80px]">
                                    <p class="text-[9px] text-white/70 uppercase font-black tracking-wider leading-none mb-1">Total</p>
                                    <p class="text-lg font-black text-white leading-none whitespace-nowrap" id="mobile-summary-total">--</p>
                                </div>
                                <button
                                    id="mobile-pay-trigger"
                                    class="flex-1 bg-white text-primary font-black px-4 py-3 rounded-xl text-xs uppercase tracking-tighter transition-all active:scale-95 shadow-lg truncate"
                                >
                                    PAY NOW
                                </button>
                            </div>
                        </div>

                        <div class="mt-4 px-2">
                             <div class="flex items-center gap-2 text-[10px] text-gray-500 justify-center">
                                <svg class="w-3 h-3 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                                <span>Includes $1000 security hold (refundable)</span>
                             </div>
                        </div>

                        <button
                            id="pay-button-desktop"
                            class="hidden md:flex w-full bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-xl shadow-lg shadow-primary/20 transition-all active:scale-95 items-center justify-center gap-2 mt-6"
                        >
                            Pay Securely
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                                ></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div id="success-modal" class="fixed inset-0 z-[100] flex items-center justify-center px-6 hidden opacity-0 transition-opacity duration-500">
        <div class="absolute inset-0 bg-dark/80 backdrop-blur-sm"></div>
        <div class="relative bg-dark-soft border border-white/10 rounded-[32px] p-8 md:p-12 max-w-lg w-full shadow-2xl scale-95 transition-transform duration-500 overflow-hidden group">
            <!-- Animated Background Glow -->
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-primary/20 blur-[80px] rounded-full"></div>
            <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-green-500/10 blur-[80px] rounded-full"></div>

            <div class="text-center relative z-10">
                <!-- Premium Checkmark Animation -->
                <div class="mb-8 flex justify-center">
                    <div class="w-24 h-24 bg-green-500/10 rounded-full flex items-center justify-center border border-green-500/20 relative">
                        <div class="absolute inset-0 bg-green-500/20 blur-2xl rounded-full scale-0 group-hover:scale-100 transition-transform duration-1000"></div>
                        <svg class="w-12 h-12 text-green-500 success-checkmark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" class="checkmark-path"></path>
                        </svg>
                    </div>
                </div>

                <h2 class="text-4xl font-black text-white mb-4 tracking-tighter uppercase">Booking Received!</h2>
                <p class="text-gray-400 font-medium mb-8 leading-relaxed">
                    Thank you for choosing Vamos Jacó. Our team will contact you via <span class="text-green-500 font-bold">WhatsApp</span> shortly to confirm your adventure and finalize the details.
                </p>

                <div class="space-y-4">
                    <a href="/" class="block w-full bg-white text-dark font-black py-4 rounded-2xl hover:bg-gray-100 transition-all active:scale-95 text-sm uppercase tracking-widest shadow-xl">
                        Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>

    <style>
        .checkmark-path {
            stroke-dasharray: 100;
            stroke-dashoffset: 100;
            animation: dash 0.8s cubic-bezier(0.65, 0, 0.45, 1) forwards;
            animation-delay: 0.5s;
        }

        @keyframes dash {
            from { stroke-dashoffset: 100; }
            to { stroke-dashoffset: 0; }
        }

        .success-btn-vibe {
            background-color: #22c55e !important;
            box-shadow: 0 10px 30px -5px rgba(34, 197, 94, 0.4) !important;
        }
        
        #success-modal.show {
            display: flex !important;
            opacity: 1;
        }
        #success-modal.show > div:last-child {
            transform: scale(1);
        }
    </style>
</Layout>

<script>
    import { bookingStore } from "../store/booking";

    // Selectors
    const summaryContainer = document.getElementById("order-summary-content");
    const totalEl = document.getElementById("summary-total");
    const subtotalEl = document.getElementById("summary-subtotal");
    const taxesEl = document.querySelector("#summary-total")?.parentElement?.previousElementSibling?.querySelector("span:last-child");
    const mobileTotalEl = document.getElementById("mobile-summary-total");
    const desktopPayBtn = document.getElementById("pay-button-desktop") as HTMLButtonElement;
    const mobilePayBtn = document.getElementById("mobile-pay-trigger") as HTMLButtonElement;
    const tilopayOpt = document.getElementById("tilopay-option");
    const cashOpt = document.getElementById("cash-option");
    
    let selectedMethod = "card";

    // Payment Method Switching
    const updateMethodUI = () => {
        const radios = document.querySelectorAll('.payment-radio');
        radios.forEach(r => {
            const isSelected = r.getAttribute('data-method') === selectedMethod;
            if (isSelected) {
                r.classList.add('border-4', 'border-primary', 'bg-white', 'shadow-[0_0_10px_rgba(255,87,34,0.3)]');
                r.classList.remove('border-2', 'border-white/20');
            } else {
                r.classList.remove('border-4', 'border-primary', 'bg-white', 'shadow-[0_0_10px_rgba(255,87,34,0.3)]');
                r.classList.add('border-2', 'border-white/20');
            }
        });

        const options = [tilopayOpt, cashOpt];
        options.forEach(opt => {
            if (!opt) return;
            const isSelected = opt.id === (selectedMethod === 'card' ? 'tilopay-option' : 'cash-option');
            opt.classList.toggle('border-primary/30', isSelected);
            opt.classList.toggle('border-white/10', !isSelected);
        });

        // Update button text
        const btns = [desktopPayBtn, mobilePayBtn];
        btns.forEach(btn => {
            if (btn) {
                btn.innerText = selectedMethod === 'card' ? 'Pay Securely' : 'Reserve & Pay on Site';
            }
        });
    };

    tilopayOpt?.addEventListener('click', () => { selectedMethod = 'card'; updateMethodUI(); });
    cashOpt?.addEventListener('click', () => { selectedMethod = 'cash'; updateMethodUI(); });

    // Helper for updating pay buttons state
    const setPayButtonsLoading = (isLoading: boolean) => {
        const btns = [desktopPayBtn, mobilePayBtn];
        btns.forEach(btn => {
            if (btn) {
                btn.disabled = isLoading;
                if (isLoading) {
                    btn.innerText = "Processing...";
                } else {
                    btn.innerText = selectedMethod === 'card' ? 'Pay Securely' : 'Reserve & Pay on Site';
                }
            }
        });
    };

    // Subscribe to store
    bookingStore.subscribe((state) => {
        if (summaryContainer && state.tourId) {
            const isVehicleTour = state.tourId === 'side-by-side-tour' || state.tourId === 'jet-ski-tour' || state.tourId === 'jaco-atv-adventure';
            
            let guestsHtml = `${state.adults} Adults, ${state.children} Kids`;
            if (isVehicleTour) {
                const vehicleName = state.tourId === 'side-by-side-tour' ? 'Buggies' : (state.tourId === 'jet-ski-tour' ? 'Jet Skis' : 'ATVs');
                guestsHtml = `${state.adults} ${vehicleName}, ${state.extraPassengers} Extra Pax`;
            }

            // Update Main Summary List
            summaryContainer.innerHTML = `
                <div class="flex gap-3 mb-4">
                    <div class="flex-1">
                        <h4 class="text-white font-bold leading-tight mb-1">${state.tourTitle || "Selected Tour"}</h4>
                        <p class="text-xs text-gray-400">Date: ${state.date ? new Date(state.date).toLocaleDateString() : "Not selected"}</p>
                    </div>
                </div>
                <div class="flex justify-between text-sm mb-4">
                    <span class="text-gray-300">Selection</span>
                    <span class="text-white font-medium">${guestsHtml}</span>
                </div>
                
                ${isVehicleTour ? `
                <div class="bg-blue-500/10 border border-blue-500/20 rounded-xl p-3 text-[10px] text-gray-400 mt-4 leading-relaxed">
                    <div class="flex gap-2">
                        <svg class="w-3.5 h-3.5 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <div>
                            <p class="font-bold text-blue-400 mb-0.5">Security Deposit Hold</p>
                            <p>A $1000 security hold will be placed on your credit card and released within 24 hours after the tour.</p>
                        </div>
                    </div>
                </div>
                ` : ''}
            `;
            
            // Update Prices
            const subtotal = state.totalPrice - state.ivaAmount;
            if (subtotalEl) subtotalEl.textContent = `$${subtotal.toFixed(2)}`;
            if (taxesEl) taxesEl.textContent = `$${state.ivaAmount.toFixed(2)}`;
            if (totalEl) totalEl.textContent = `$${state.totalPrice.toFixed(2)}`;
            if (mobileTotalEl) mobileTotalEl.textContent = `$${state.totalPrice.toFixed(2)}`;

        } else if (summaryContainer) {
            summaryContainer.innerHTML = `<p class="text-gray-500 text-sm">No tour selected.</p>`;
        }
    });

    // Payment Logic
    const handlePayment = async () => {
        const state = bookingStore.get();
        if (!state.tourId) {
            alert("Please select a tour first.");
            return;
        }

        try {
            setPayButtonsLoading(true);

            const formData = {
                firstName: (document.querySelector('input[placeholder="John"]') as HTMLInputElement)?.value,
                lastName: (document.querySelector('input[placeholder="Doe"]') as HTMLInputElement)?.value,
                email: (document.querySelector('input[placeholder="john@example.com"]') as HTMLInputElement)?.value,
                phone: (document.querySelector('input[placeholder="+1 (555) 000-0000"]') as HTMLInputElement)?.value,
            };

            if (!formData.firstName || !formData.email) {
                alert("Please fill in your details.");
                setPayButtonsLoading(false);
                return;
            }

            if (selectedMethod === 'cash') {
                const res = await fetch("/api/bookings/create", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            customerName: `${formData.firstName} ${formData.lastName}`,
                            customerEmail: formData.email,
                            customerPhone: formData.phone,
                            tourId: state.tourId,
                            tourName: state.tourTitle,
                            date: state.date,
                            totalAmount: state.totalPrice,
                            adults: state.adults,
                            children: state.children,
                            status: 'pending' // For cash/whatsapp
                        }),
                });

                const data = await res.json();
                if (data.success) {
                    // Start success sequence
                    const modal = document.getElementById('success-modal');
                    const btns = [desktopPayBtn, mobilePayBtn];
                    
                    btns.forEach(btn => {
                        if (btn) {
                            btn.classList.add('success-btn-vibe');
                            btn.innerHTML = `
                                <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                </svg>
                                CONFIRMED!
                            `;
                        }
                    });

                    setTimeout(() => {
                        modal?.classList.add('show');
                        // Auto-redirect after 6 seconds
                        setTimeout(() => {
                            window.location.href = "/";
                        }, 6000);
                    }, 1000);

                } else {
                    alert("Failed to create booking: " + (data.message || "Unknown error"));
                }
            } else {
                // TiloPay Flow
                const res = await fetch("/api/create-payment", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        tourId: state.tourId,
                        amount: state.totalPrice,
                        date: state.date,
                        adults: state.adults,
                        children: state.children,
                        extraPassengers: state.extraPassengers,
                        customer: formData
                    }),
                });

                const data = await res.json();
                if (data.redirectUrl) {
                    window.location.href = data.redirectUrl;
                } else {
                    alert("Payment initialization failed: " + (data.message || "Unknown error"));
                }
            }
        } catch (e) {
            console.error(e);
            alert("An error occurred. Please try again.");
        } finally {
            setPayButtonsLoading(false);
        }
    };

    [desktopPayBtn, mobilePayBtn].forEach(btn => {
        if (btn) btn.addEventListener("click", handlePayment);
    });
</script>
