---
import Layout from "../layouts/Layout.astro";
import AboutSection from "../components/AboutSection";
import TeamSection from "../components/TeamSection";
import TrustBar from "../components/TrustBar";
import AboutGallery from "../components/AboutGallery";
import NewsletterSection from "../components/NewsletterSection";
import FaqSection from "../components/FaqSection";
import ScrollReveal from "../components/ScrollReveal";
import { fetchWPAPI } from "../lib/wp";
import { getTeamMembers } from "../lib/supabase-team";
import {
    getOrganizationSchema,
    getBreadcrumbSchema,
    getFAQSchema,
} from "../lib/seo-schemas";

// Hero Image - Costa Rica jungle themed
const HERO_IMAGE = "/images/Flyboard/flyboard-vamos-jaco-tours-004.jpg";

// Fetch Team Members from Supabase
let teamMembers: any[] = [];
try {
    const members = await getTeamMembers();
    if (members && members.length > 0) {
        teamMembers = members.map((m) => ({
            id: m.id,
            name: m.name,
            position: m.position_en || "Team Member",
            position_en: m.position_en || undefined,
            position_es: m.position_es || undefined,
            image:
                m.image_url ||
                "https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=2574&auto=format&fit=crop",
            social: {
                instagram: m.social_instagram || undefined,
                linkedin: m.social_linkedin || undefined,
                twitter: m.social_twitter || undefined,
            },
        }));
    }
} catch (e) {
    console.error("Failed to load Team Members:", e);
}

// Fetch FAQs
let wpFaqs: any[] = [];
try {
    const rawFaqs = await fetchWPAPI("faq");
    if (rawFaqs && Array.isArray(rawFaqs)) {
        wpFaqs = rawFaqs.map((f: any) => ({
            question: f.title.rendered,
            // Remove the <p> tags from the excerpt
            answer: f.excerpt.rendered.replace(/<\/?p>/g, "").trim(),
        }));
    }
} catch (e) {
    console.error("Failed to load WP FAQs:", e);
}

const schemas = [
    getOrganizationSchema(),
    getBreadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "About Us", url: "/about" },
    ]),
    ...(wpFaqs.length > 0 ? [getFAQSchema(wpFaqs)] : []),
].filter(Boolean);
---

<Layout
    title="About Us | Vamos Jacó Tours — Local Adventure Experts Founded 2018"
    description="Vamos Jacó Tours — local adventure tour company founded in 2018 in Jacó, Costa Rica. Expert local guides for ATV, jet ski, zipline and surf. ICT licensed."
    keywords="about Vamos Jacó, Costa Rica tour guides, Jacó local guides, adventure tour company, Costa Rica travel agency"
    jsonLd={schemas}
    preloadImage={HERO_IMAGE}
>
    {/* Page Hero */}
    <section
        class="relative h-[60vh] min-h-[450px] flex items-center justify-center overflow-hidden"
    >
        <div class="absolute inset-0">
            <img
                src={HERO_IMAGE}
                alt="Costa Rica Rainforest"
                class="w-full h-full object-cover opacity-60"
            />
            <div
                class="absolute inset-0 bg-gradient-to-b from-dark/30 via-dark/60 to-dark"
            >
            </div>
        </div>
        <div
            class="relative z-10 text-center px-6 max-w-5xl mx-auto animate-zoom-in"
        >
            <span
                class="inline-block bg-brand-teal/20 backdrop-blur-sm border border-brand-teal/30 text-brand-teal px-4 py-1 rounded-full text-sm font-bold tracking-widest uppercase mb-6"
                >Our Story</span
            >
            <h1
                class="text-5xl md:text-8xl font-black text-white mb-6 uppercase tracking-tighter drop-shadow-2xl"
            >
                Passion for
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-brand-teal via-brand-orange to-brand-yellow animate-gradient-text"
                >
                    Adventure
                </span>
            </h1>
            <p
                class="text-xl md:text-2xl text-gray-200 font-bold max-w-3xl mx-auto tracking-wide"
            >
                We are more than a tour agency. We are your local friends
                showing you the hidden gems of Jacó.
            </p>
        </div>
    </section>

    <!-- Company Story Section -->
    <section class="py-24 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-1/3 h-1/3 bg-brand-teal/10 blur-[100px] rounded-full pointer-events-none"></div>
        <div class="max-w-4xl mx-auto px-6 relative z-10">
            <span class="text-brand-teal font-bold tracking-widest uppercase text-sm mb-4 block">Our Story</span>
            <h2 class="text-4xl md:text-6xl font-black text-white uppercase tracking-tight italic mb-8">
                Born in Jacó,
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-teal to-brand-orange">Built by Locals</span>
            </h2>
            <div class="space-y-6 text-gray-300 text-lg leading-relaxed">
                <p>
                    Vamos Jacó Tours was founded in 2018 with a simple belief: the best way to experience Costa Rica is through the eyes of someone who calls it home. What started as a small operation running ATV tours through the hills behind Jacó has grown into a multi-sport adventure tour company Jacó travelers trust for everything from jet ski ocean rides to zipline canopy crossings.
                </p>
                <p>
                    As a family-owned business rooted in the community, every decision we make starts with the same question: would we take our own family on this tour? The answer guides how we train our staff, choose our equipment, and treat every guest who books with us. We are not a corporate call center booking tours from a desk in the capital. We live here, work here, and reinvest in the local economy — from the sodas where we stop for lunch to the conservation initiatives that keep our trails and waters pristine.
                </p>
                <p>
                    Our team is made up entirely of local guides Costa Rica trained, certified, and deeply familiar with every trail, tide, and wildlife pattern along the central Pacific coast. When you ride with us, you ride with people who grew up surfing these waves, hiking these ridges, and navigating these rivers. That local knowledge transforms a good tour into an unforgettable one.
                </p>
            </div>
        </div>
    </section>

    <!-- Why Local Matters Section -->
    <section class="py-20 relative">
        <div class="absolute bottom-0 left-0 w-1/3 h-1/3 bg-primary/10 blur-[100px] rounded-full pointer-events-none"></div>
        <div class="max-w-4xl mx-auto px-6 relative z-10">
            <div class="bg-[#0d0d0d] border border-white/10 rounded-3xl p-10 md:p-14">
                <span class="text-brand-orange font-bold tracking-widest uppercase text-sm mb-3 block">Why Local Matters</span>
                <h3 class="text-3xl md:text-4xl font-black text-white uppercase tracking-tight italic mb-8">
                    Big enough to deliver, <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-orange to-brand-yellow">small enough to care</span>
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-gray-300">
                    <div>
                        <div class="w-12 h-12 rounded-full bg-brand-orange/20 flex items-center justify-center mb-5"><svg class="w-6 h-6 text-brand-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg></div>
                        <h4 class="text-white font-bold text-lg mb-2">Local Knowledge</h4>
                        <p class="text-sm leading-relaxed">Our guides know the best trails, the quietest beaches, and the safest routes because they explore them year-round. No scripted tours — every experience is shaped by real, on-the-ground expertise.</p>
                    </div>
                    <div>
                        <div class="w-12 h-12 rounded-full bg-brand-teal/20 flex items-center justify-center mb-5"><svg class="w-6 h-6 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>
                        <h4 class="text-white font-bold text-lg mb-2">Flexible Scheduling</h4>
                        <p class="text-sm leading-relaxed">Need a later pickup? Want to combine two activities? We adjust on the fly. Local ownership means we can say yes to requests that big operators cannot accommodate.</p>
                    </div>
                    <div>
                        <div class="w-12 h-12 rounded-full bg-primary/20 flex items-center justify-center mb-5"><svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div>
                        <h4 class="text-white font-bold text-lg mb-2">Community Impact</h4>
                        <p class="text-sm leading-relaxed">We hire locally, source from local businesses, and contribute to community projects. Choosing a local operator means your tourism dollars stay in Jacó and support the families who make this town special.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Certifications & Trust Section -->
    <section class="py-16 border-t border-white/5">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 text-gray-400 text-sm font-medium">
                <span class="flex items-center gap-3"><svg class="w-5 h-5 text-brand-teal shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg> Licensed by the Costa Rica Tourism Board (ICT)</span>
                <span class="flex items-center gap-3"><svg class="w-5 h-5 text-brand-teal shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Certified bilingual guides</span>
                <span class="flex items-center gap-3"><svg class="w-5 h-5 text-brand-teal shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg> Fully insured operations</span>
            </div>
        </div>
    </section>

    <main class="relative">
        {/* Background Blobs */}
        <div
            class="absolute top-0 right-0 w-1/3 h-1/3 bg-brand-teal/10 blur-[100px] rounded-full pointer-events-none"
        >
        </div>
        <div
            class="absolute bottom-1/3 left-0 w-1/3 h-1/3 bg-primary/10 blur-[100px] rounded-full pointer-events-none"
        >
        </div>

        {/* Main Info & Stats */}
        <ScrollReveal client:visible animation="fade-up">
            <AboutSection client:visible />
        </ScrollReveal>

        {/* Team Carousel */}
        <ScrollReveal client:visible animation="fade-left">
            <TeamSection client:visible members={teamMembers} />
        </ScrollReveal>

        {/* Gallery "Moments" */}
        <ScrollReveal client:visible animation="scale-in" delay={100}>
            <AboutGallery client:visible />
        </ScrollReveal>

        {/* Trust/Partners */}
        <ScrollReveal client:visible animation="blur-in">
            <TrustBar client:visible />
        </ScrollReveal>

        {/* FAQ Section */}
        <ScrollReveal client:visible animation="blur-in">
            <FaqSection client:visible />
        </ScrollReveal>

        {/* Newsletter CTA */}
        <ScrollReveal client:visible animation="fade-up" delay={200}>
            <NewsletterSection client:visible />
        </ScrollReveal>
    </main>
</Layout>
