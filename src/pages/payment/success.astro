---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer';
import { CheckCircle, ArrowRight, Calendar, Users, MapPin } from 'lucide-react';

const orderId = Astro.url.searchParams.get('order');
---

<Layout title="Payment Successful | Vamos Jacó Tours">
    <main class="min-h-screen bg-dark flex flex-col justify-between">
        <div class="flex-1 flex items-center justify-center p-6 mt-20">
            <div class="max-w-md w-full bg-[#151b2b] rounded-3xl p-8 border border-white/10 shadow-2xl relative overflow-hidden">
                <!-- Glowing effect behind -->
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-1/2 bg-primary/20 blur-[100px] pointer-events-none"></div>
                
                <div class="relative z-10 flex flex-col items-center text-center">
                    <div class="w-20 h-20 bg-green-500/10 rounded-full flex items-center justify-center mb-6">
                        <CheckCircle className="w-10 h-10 text-green-500" />
                    </div>
                    
                    <h1 class="text-3xl font-black text-white mb-2 uppercase tracking-tight">Payment Successful!</h1>
                    <p class="text-gray-400 mb-8">Your adventure in Costa Rica is officially confirmed. We've sent a detailed itinerary to your email.</p>
                    
                    <div class="w-full bg-dark/50 rounded-2xl p-6 border border-white/5 mb-8">
                        <p class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-1">Order Reference</p>
                        <p class="text-white font-mono text-xs break-all">{orderId || 'CONFIRMED'}</p>
                    </div>
                    
                    <div class="space-y-4 w-full">
                        <a href="https://wa.me/50687747250" class="w-full flex items-center justify-center gap-2 bg-brand-teal hover:bg-brand-teal/90 text-white font-bold py-4 px-6 rounded-full transition-colors">
                            Chat with Concierge <ArrowRight className="w-5 h-5" />
                        </a>
                        <a href="/" class="w-full block bg-transparent border border-white/20 hover:bg-white/5 text-white font-bold py-4 px-6 rounded-full transition-colors text-center">
                            Return Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <Footer client:visible />
    </main>
</Layout>
