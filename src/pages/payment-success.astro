---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Payment Successful | Vamos Jacó Tours"
    robots="noindex, nofollow"
>
    <div
        class="min-h-screen bg-dark flex items-center justify-center relative overflow-hidden"
    >
        <!-- Background Elements -->
        <div
            class="absolute top-0 right-0 w-96 h-96 bg-primary/10 rounded-full blur-[120px] pointer-events-none"
        >
        </div>
        <div
            class="absolute bottom-0 left-0 w-96 h-96 bg-brand-orange/10 rounded-full blur-[120px] pointer-events-none"
        >
        </div>

        <div class="max-w-md w-full mx-auto px-6 relative z-10 text-center">
            <div
                class="bg-dark-soft border border-white/10 rounded-3xl p-8 md:p-12 shadow-2xl"
            >
                <!-- Success Icon -->
                <div
                    class="w-20 h-20 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-6 ring-2 ring-green-500/50"
                >
                    <svg
                        class="w-10 h-10 text-green-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="3"
                            d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>

                <h1
                    id="success-title"
                    class="text-3xl font-black text-white italic uppercase tracking-tight mb-4"
                >
                    Payment <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-brand-orange"
                        >Successful!</span
                    >
                </h1>

                <p id="success-message-1" class="text-gray-400 mb-2">
                    Your booking has been confirmed!
                </p>
                <p id="success-message-2" class="text-gray-400 mb-8">
                    A confirmation email with all the details of your adventure has been sent to your inbox. Please check your spam folder if you don't see it.
                </p>

                <div class="space-y-4">
                    <a
                        href="/tours"
                        id="btn-another"
                        class="block w-full bg-primary hover:bg-primary/90 text-white font-bold py-3 rounded-xl transition-colors shadow-lg shadow-primary/20"
                    >
                        Book Another Adventure
                    </a>
                    <a
                        href="/"
                        id="btn-home"
                        class="block w-full bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold py-3 rounded-xl transition-colors"
                    >
                        Return Home
                    </a>
                </div>
            </div>

            <p class="mt-8 text-xs text-gray-500">
                <span id="order-label">Order Reference:</span> <span
                    id="order-ref"
                    class="font-mono text-gray-400">--</span
                >
            </p>
        </div>
    </div>
</Layout>

<script>
    import { language, initLanguage } from "../store";

    // Initialize language from localStorage
    initLanguage();

    const content = {
        en: {
            title: 'Payment <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-brand-orange">Successful!</span>',
            message1: 'Your booking has been confirmed!',
            message2: 'A confirmation email with all the details of your adventure has been sent to your inbox. Please check your spam folder if you don\'t see it.',
            btnAnother: 'Book Another Adventure',
            btnHome: 'Return Home',
            orderLabel: 'Order Reference:',
        },
        es: {
            title: 'Pago <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-brand-orange">Exitoso!</span>',
            message1: 'Tu reservación ha sido confirmada!',
            message2: 'Un correo de confirmación con todos los detalles de tu aventura ha sido enviado a tu bandeja de entrada. Revisa tu carpeta de spam si no lo ves.',
            btnAnother: 'Reservar Otra Aventura',
            btnHome: 'Volver al Inicio',
            orderLabel: 'Referencia de Orden:',
        }
    };

    const updateContent = (lang: 'en' | 'es') => {
        const c = content[lang];
        const titleEl = document.getElementById("success-title");
        const msg1El = document.getElementById("success-message-1");
        const msg2El = document.getElementById("success-message-2");
        const btnAnotherEl = document.getElementById("btn-another");
        const btnHomeEl = document.getElementById("btn-home");
        const orderLabelEl = document.getElementById("order-label");

        if (titleEl) titleEl.innerHTML = c.title;
        if (msg1El) msg1El.textContent = c.message1;
        if (msg2El) msg2El.textContent = c.message2;
        if (btnAnotherEl) btnAnotherEl.textContent = c.btnAnother;
        if (btnHomeEl) btnHomeEl.textContent = c.btnHome;
        if (orderLabelEl) orderLabelEl.textContent = c.orderLabel;
    };

    // Subscribe to language changes
    language.subscribe((lang) => {
        updateContent(lang);
    });

    // Get order ID from URL parameter
    const urlParams = new URLSearchParams(window.location.search);
    const orderId = urlParams.get("order");
    const orderRefEl = document.getElementById("order-ref");
    if (orderRefEl) {
        orderRefEl.textContent = orderId || '--';
    }

    // Clear the cart on success
    import { bookingStore } from "../store/booking";
    // Reset store
    bookingStore.set({
        tourId: null,
        tourTitle: null,
        date: null,
        time: null,
        adults: 1,
        children: 0,
        pricePerAdult: 0,
        pricePerChild: 0,
        totalPrice: 0,
        ivaAmount: 0,
        extraPassengers: 0,
    });
</script>
