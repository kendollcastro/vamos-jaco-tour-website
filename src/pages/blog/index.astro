---
import Layout from "../../layouts/Layout.astro";
import NewsletterSection from "../../components/NewsletterSection";
import { getOrganizationSchema, getBreadcrumbSchema } from "../../lib/seo-schemas";

const schemas = [
    getOrganizationSchema(),
    getBreadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Travel Guide", url: "/blog" },
    ]),
];

const articles = [
    {
        title: "Best Time to Visit Jacó Costa Rica",
        excerpt: "Complete seasonal guide covering weather, surfing conditions, and travel tips for every season.",
        date: "January 15, 2025",
        readTime: "8 min",
        slug: "best-time-to-visit-jaco-costa-rica",
        image: "https://images.unsplash.com/photo-1518495973542-4542c06a5843?w=600&h=400&fit=crop",
    },
    {
        title: "ATV vs Side-by-Side: Which Off-Road Adventure is Right for You?",
        excerpt: "Compare the thrill of ATVs and UTVs for your Jacó jungle adventure. Learn which vehicle suits your experience level and group size.",
        date: "January 20, 2025",
        readTime: "6 min",
        slug: "atv-vs-side-by-side-costa-rica",
        image: "https://images.unsplash.com/photo-1616314923371-1a11d5d4e64c?w=600&h=400&fit=crop",
    },
    {
        title: "Ultimate Costa Rica Packing List for Adventure Travelers",
        excerpt: "Don't forget the essentials! Our comprehensive packing guide for jungle hikes, water sports, and beach activities.",
        date: "January 25, 2025",
        readTime: "5 min",
        slug: "costa-rica-packing-list",
        image: "https://images.unsplash.com/photo-1501554728187-ce4db6b413d5?w=600&h=400&fit=crop",
    },
    {
        title: "5 Must-Try Adventures in Jacó Beach",
        excerpt: "From jet ski tours to zipline canopy, discover the top experiences that make Jacó Costa Rica's adventure capital.",
        date: "February 1, 2025",
        readTime: "7 min",
        slug: "top-adventures-jaco-costa-rica",
        image: "https://images.unsplash.com/photo-1596178065887-1198b6148b2b?w=600&h=400&fit=crop",
    },
];
---

<Layout
    title="Travel Guides | Vamos Jacó Tours — Costa Rica Adventure"
    description="Expert travel guides for Jacó Beach, Costa Rica. Learn about the best time to visit, adventure comparisons, and must-try activities."
    keywords="Jacó travel guide, Costa Rica blog, Jaco tours guide, adventure travel Costa Rica"
    jsonLd={schemas}
>
    <main class="relative py-20">
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute top-0 right-0 w-1/3 h-1/3 bg-brand-teal/10 blur-[100px] rounded-full"></div>
            <div class="absolute bottom-0 left-0 w-1/3 h-1/3 bg-primary/10 blur-[100px] rounded-full"></div>
        </div>

        <div class="max-w-6xl mx-auto px-6 relative z-10">
            <div class="text-center mb-16">
                <span class="text-brand-orange font-bold text-sm tracking-widest uppercase">Expert Advice</span>
                <h1 class="text-4xl md:text-6xl font-black text-white mt-2 uppercase italic">Travel Guides</h1>
                <p class="text-gray-400 mt-4 max-w-2xl mx-auto">Insider tips, seasonal advice, and adventure comparisons to help you plan the perfect Jacó Beach vacation.</p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {articles.map((article, i) => (
                    <a href={`/blog/${article.slug}`} class="group block bg-white/5 border border-white/10 rounded-2xl overflow-hidden hover:border-primary/50 transition-all hover:shadow-[0_0_40px_rgba(220,53,34,0.2)] hover:-translate-y-1">
                        <div class="relative h-48 overflow-hidden">
                            <img 
                                src={article.image}
                                alt={article.title}
                                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-dark/80 to-transparent"></div>
                        </div>
                        <div class="p-6">
                            <div class="flex items-center gap-3 text-gray-500 text-xs mb-3">
                                <span>{article.date}</span>
                                <span class="w-1 h-1 bg-gray-600 rounded-full"></span>
                                <span>{article.readTime} read</span>
                            </div>
                            <h2 class="text-xl font-bold text-white group-hover:text-brand-orange transition-colors">{article.title}</h2>
                            <p class="text-gray-400 text-sm mt-2 line-clamp-2">{article.excerpt}</p>
                            <span class="inline-flex items-center gap-2 text-brand-orange text-sm font-medium mt-4 group-hover:gap-3 transition-all">
                                Read More
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                            </span>
                        </div>
                    </a>
                ))}
            </div>
        </div>

        <NewsletterSection client:visible />
    </main>
</Layout>