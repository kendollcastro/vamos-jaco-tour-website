---
import Layout from "../../layouts/Layout.astro";
import NewsletterSection from "../../components/NewsletterSection";
import { getOrganizationSchema, getBreadcrumbSchema } from "../../lib/seo-schemas";

const schemas = [
    getOrganizationSchema(),
    getBreadcrumbSchema([
        { name: "Home", url: "/" },
        { name: "Travel Guide", url: "/blog" },
        { name: "ATV vs Side-by-Side Guide", url: "/blog/atv-vs-side-by-side-costa-rica" },
    ]),
];
---

<Layout
    title="ATV vs Side-by-Side Costa Rica | Which Off-Road Adventure is Best?"
    description="Compare ATV vs UTV (Side-by-Side) tours in Jacó Costa Rica. Learn which vehicle is better for beginners, families, thrill-seekers, and groups."
    keywords="ATV vs side by side Costa Rica, UTV tour Jaco, quad vs buggy Costa Rica, off-road adventure Costa Rica"
    jsonLd={schemas}
>
    <main class="relative py-20">
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute top-0 right-0 w-1/3 h-1/3 bg-brand-teal/10 blur-[100px] rounded-full"></div>
            <div class="absolute bottom-0 left-0 w-1/3 h-1/3 bg-primary/10 blur-[100px] rounded-full"></div>
        </div>

        <article class="max-w-4xl mx-auto px-6 relative z-10">
            <a href="/blog" class="inline-flex items-center gap-2 text-brand-orange hover:text-white transition-colors mb-8">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                Back to Travel Guides
            </a>

            <span class="text-brand-orange font-bold text-sm tracking-widest uppercase">Adventure Guide</span>
            <h1 class="text-4xl md:text-5xl font-black text-white mt-2 mb-6 uppercase italic">ATV vs Side-by-Side: Which Off-Road Adventure is Right for You?</h1>
            
            <div class="flex items-center gap-4 text-gray-400 text-sm mb-10">
                <span>January 20, 2025</span>
                <span class="w-1 h-1 bg-gray-600 rounded-full"></span>
                <span>6 min read</span>
            </div>

            <img 
                src="https://images.unsplash.com/photo-1616314923371-1a11d5d4e64c?w=1200&h=600&fit=crop"
                alt="ATV tour in Costa Rica jungle"
                class="w-full h-[400px] object-cover rounded-2xl mb-10"
            />

            <div class="prose prose-invert prose-lg max-w-none text-gray-300">
                <p class="text-xl leading-relaxed mb-8">Ready to explore the Costa Rican jungle but can't decide between an ATV or Side-by-Side (UTV)? Here's our complete comparison to help you choose the perfect off-road adventure.</p>

                <h2 class="text-2xl font-bold text-white mt-12 mb-4">What's the Difference?</h2>
                <div class="grid md:grid-cols-2 gap-6 my-8">
                    <div class="bg-white/5 border border-white/10 rounded-xl p-6">
                        <h3 class="text-white font-bold text-lg mb-3">🏍️ ATV (All-Terrain Vehicle)</h3>
                        <p class="text-gray-400">A single-rider vehicle where you sit on top and steer with handlebars. Also known as "quads" or "quad bikes."</p>
                    </div>
                    <div class="bg-white/5 border border-white/10 rounded-xl p-6">
                        <h3 class="text-white font-bold text-lg mb-3">🚙 Side-by-Side (UTV)</h3>
                        <p class="text-gray-400">A two-seater vehicle with a steering wheel, seat belts, and roll cage. Also called "buggies" or "RUVs."</p>
                    </div>
                </div>

                <h2 class="text-2xl font-bold text-white mt-12 mb-4">Choose ATV If...</h2>
                <ul class="list-disc pl-6 space-y-3 my-6">
                    <li><strong class="text-white">You want full control</strong> — Steer your own adventure through the jungle</li>
                    <li><strong class="text-white">You're a thrill-seeker</strong> — The open-air experience amplifies every bump and splash</li>
                    <li><strong class="text-white">Traveling solo</strong> — No need to wait for others to join</li>
                    <li><strong class="text-white">Budget-conscious</strong> — Typically $10-20 cheaper than Side-by-Side tours</li>
                    <li><strong class="text-white">Experienced rider</strong> — Some driving skill required</li>
                </ul>

                <h2 class="text-2xl font-bold text-white mt-12 mb-4">Choose Side-by-Side If...</h2>
                <ul class="list-disc pl-6 space-y-3 my-6">
                    <li><strong class="text-white">Safety is priority</strong> — Roll cage and seat belts provide extra protection</li>
                    <li><strong class="text-white">Traveling with family</strong> — Kids can ride along comfortably</li>
                    <li><strong class="text-white">No riding experience</strong> — Easy to drive, automatic transmission</li>
                    <li><strong class="text-white">Want comfort</strong> — Enclosed cabin protects from mud and rain</li>
                    <li><strong class="text-white">Photography focus</strong> — Easier to take photos while someone else drives</li>
                </ul>

                <h2 class="text-2xl font-bold text-white mt-12 mb-4">Comparison Table</h2>
                <div class="overflow-x-auto my-8">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-white/20">
                                <th class="py-3 text-left text-white font-bold">Feature</th>
                                <th class="py-3 text-center text-white font-bold">ATV</th>
                                <th class="py-3 text-center text-white font-bold">Side-by-Side</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b border-white/10">
                                <td class="py-3 text-gray-300">Price (per person)</td>
                                <td class="py-3 text-center text-brand-orange">$60-80</td>
                                <td class="py-3 text-center text-brand-orange">$80-120</td>
                            </tr>
                            <tr class="border-b border-white/10">
                                <td class="py-3 text-gray-300">Seating</td>
                                <td class="py-3 text-center">1 person</td>
                                <td class="py-3 text-center">2-4 people</td>
                            </tr>
                            <tr class="border-b border-white/10">
                                <td class="py-3 text-gray-300">Experience Needed</td>
                                <td class="py-3 text-center">Some</td>
                                <td class="py-3 text-center">None</td>
                            </tr>
                            <tr class="border-b border-white/10">
                                <td class="py-3 text-gray-300">Open Air</td>
                                <td class="py-3 text-center">Yes</td>
                                <td class="py-3 text-center">Partial</td>
                            </tr>
                            <tr class="border-b border-white/10">
                                <td class="py-3 text-gray-300">Thrill Level</td>
                                <td class="py-3 text-center">🔥🔥🔥🔥🔥</td>
                                <td class="py-3 text-center">🔥🔥🔥</td>
                            </tr>
                            <tr>
                                <td class="py-3 text-gray-300">Best For</td>
                                <td class="py-3 text-center">Solo adventurers</td>
                                <td class="py-3 text-center">Families & couples</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <h2 class="text-2xl font-bold text-white mt-12 mb-4">What You'll Experience in Jacó</h2>
                <p>Both tours take you through Costa Rica's stunning rainforest, crossing rivers, climbing mountain trails, and visiting hidden waterfalls. You'll see breathtaking views of the Pacific coast and spot exotic wildlife like toucans, monkeys, and sloths.</p>

                <div class="bg-brand-orange/10 border border-brand-orange/30 rounded-xl p-6 my-8">
                    <h3 class="text-white font-bold mb-2">💡 Pro Tip</h3>
                    <p class="text-gray-300">Book the "Combo Tour" that includes both ATV and zipline — it's the most popular adventure in Jacó and gives you the best of both worlds!</p>
                </div>

                <h2 class="text-2xl font-bold text-white mt-12 mb-4">Ready to Ride?</h2>
                <p>Book your Jacó off-road adventure today! Both options include professional bilingual guides, safety gear, and transportation from your hotel.</p>
                
                <div class="grid md:grid-cols-2 gap-4 mt-8">
                    <a href="/tours/jaco-atv-adventure" class="block text-center py-4 px-6 bg-white/10 border border-white/20 rounded-xl text-white font-bold hover:bg-primary/20 hover:border-primary transition-all">
                        🏍️ Book ATV Tour
                    </a>
                    <a href="/tours/side-by-side-tour" class="block text-center py-4 px-6 bg-white/10 border border-white/20 rounded-xl text-white font-bold hover:bg-primary/20 hover:border-primary transition-all">
                        🚙 Book Side-by-Side Tour
                    </a>
                </div>
            </div>
        </article>

        <NewsletterSection client:visible />
    </main>
</Layout>