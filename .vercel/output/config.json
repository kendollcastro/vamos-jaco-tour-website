{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/about/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/admin/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/api/admin/settings/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/api/admin/test-email/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/api/bookings/create/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/api/media/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/api/newsletter/subscribe/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/api/tilopay/callback/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/api/tilopay-webhook/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/brief/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/checkout/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/contact/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/design-system/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/payment-failure/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/payment-success/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/tours/([^/]+?)/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/tours/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}