		{
			"src": "^/api/admin/settings/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/test-email/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/bookings/check-availability/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/bookings/create/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/bookings/initiate/?$",
			"dest": "_render"
