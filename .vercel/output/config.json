		{
			"src": "^/payment-success/?$",
			"dest": "_render"
		},
		{
			"src": "^/tours/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/tours/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
