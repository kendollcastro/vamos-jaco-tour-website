---
import Layout from "../layouts/Layout.astro";
import ScrollReveal from "../components/ScrollReveal";

const colors = [
    { name: "Primary Red", hex: "#D92818", variable: "bg-primary", text: "text-white" },
    { name: "Brand Teal", hex: "#03A696", variable: "bg-brand-teal", text: "text-white" },
    { name: "Brand Orange", hex: "#F27F1B", variable: "bg-brand-orange", text: "text-white" },
    { name: "Brand Yellow", hex: "#F2AB27", variable: "bg-brand-yellow", text: "text-white" },
    { name: "Dark BG", hex: "#0D0D12", variable: "bg-dark", text: "text-white" },
];

const adventures = [
    { category: "Terrestres", items: ["ATV (Cuadraciclos)", "Side-by-Side (Buggies)"] },
    { category: "Acuáticas", items: ["Jet Ski", "Surf Lessons", "Flyboard", "Banana Boat"] },
    { category: "Naturaleza", items: ["Zipline (Canopy)", "Tours de Naturaleza"] },
];
---

<Layout 
    title="Project Brief | Vamos Jacó Tours" 
    description="Documento oficial de identidad de marca y guía para diseñadores de Vamos Jacó Tours."
>
    <main class="py-24 px-6 max-w-4xl mx-auto text-white">
        <ScrollReveal client:visible animation="fade-up">
            <header class="mb-16 border-b border-white/10 pb-12">
                <span class="text-brand-teal font-bold tracking-widest uppercase mb-4 block">Documentación Interna</span>
                <h1 class="text-5xl md:text-7xl font-black mb-6 uppercase tracking-tighter">
                    Brief del <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-brand-orange">Proyecto</span>
                </h1>
                <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
                    Esta guía define la esencia, objetivos e identidad visual de <strong>Vamos Jacó Tours</strong> para asegurar coherencia en cada punto de contacto con el cliente.
                </p>
            </header>
        </ScrollReveal>

        <section class="space-y-20">
            {/* Resumen */}
            <ScrollReveal client:visible animation="fade-up">
                <div class="grid md:grid-cols-3 gap-12">
                    <div class="md:col-span-1">
                        <h2 class="text-2xl font-bold uppercase tracking-wider text-brand-orange">01. Resumen</h2>
                    </div>
                    <div class="md:col-span-2 space-y-4 text-gray-300 text-lg leading-relaxed">
                        <p>
                            <strong class="text-white">Vamos Jacó Tours</strong> es una agencia familiar nacida en 2018. Somos expertos locales que buscamos democratizar el acceso a la mejor aventura en Jacó.
                        </p>
                        <p>
                            No solo vendemos tours; vendemos el <strong>espíritu de Costa Rica</strong> a través de ojos locales.
                        </p>
                    </div>
                </div>
            </ScrollReveal>

            {/* Identidad */}
            <ScrollReveal client:visible animation="fade-up">
                <div class="grid md:grid-cols-3 gap-12">
                    <div class="md:col-span-1">
                        <h2 class="text-2xl font-bold uppercase tracking-wider text-brand-teal">02. Identidad</h2>
                    </div>
                    <div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-8">
                        <div>
                            <h3 class="text-white font-bold mb-2">Valores</h3>
                            <ul class="text-gray-400 space-y-1">
                                <li>• Autenticidad Local</li>
                                <li>• Seguridad Total</li>
                                <li>• Pasión Extrema</li>
                                <li>• Hospitalidad Tica</li>
                            </ul>
                        </div>
                        <div>
                            <h3 class="text-white font-bold mb-2">Personalidad</h3>
                            <p class="text-gray-400">Enérgica, confiable, experta y tan acogedora como un amigo de toda la vida.</p>
                        </div>
                    </div>
                </div>
            </ScrollReveal>

            {/* Colores */}
            <ScrollReveal client:visible animation="fade-up">
                <div class="grid md:grid-cols-3 gap-12">
                    <div class="md:col-span-1">
                        <h2 class="text-2xl font-bold uppercase tracking-wider text-primary">03. Visuales</h2>
                    </div>
                    <div class="md:col-span-2 space-y-8">
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                            {colors.map(color => (
                                <div class="space-y-2">
                                    <div class={`h-24 rounded-2xl ${color.variable} shadow-lg flex items-end p-3`}>
                                        <span class={`text-[10px] font-bold uppercase ${color.text}`}>{color.hex}</span>
                                    </div>
                                    <p class="text-xs text-gray-500 font-medium">{color.name}</p>
                                </div>
                            ))}
                        </div>
                        <div class="grid grid-cols-2 gap-8 pt-4">
                            <div>
                                <h3 class="text-white font-bold mb-2 italic">Tipografía Sans</h3>
                                <p class="text-2xl font-sans font-black">Outfit / Poppins</p>
                                <p class="text-gray-500 text-sm">Moderna & Audaz</p>
                            </div>
                            <div>
                                <h3 class="text-white font-bold mb-2 italic">Acentos</h3>
                                <p class="text-2xl font-script text-brand-teal">Kaushan Script</p>
                                <p class="text-gray-500 text-sm">Orgánico & Pura Vida</p>
                            </div>
                        </div>
                    </div>
                </div>
            </ScrollReveal>

            {/* Aventuras */}
            <ScrollReveal client:visible animation="fade-up">
                <div class="grid md:grid-cols-3 gap-12">
                    <div class="md:col-span-1">
                        <h2 class="text-2xl font-bold uppercase tracking-wider text-brand-yellow">04. Catálogo</h2>
                    </div>
                    <div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-8">
                        {adventures.map(adv => (
                            <div>
                                <h3 class="text-white font-bold mb-3 border-b border-white/10 pb-2">{adv.category}</h3>
                                <ul class="text-gray-400 text-sm space-y-2">
                                    {adv.items.map(item => <li>{item}</li>)}
                                </ul>
                            </div>
                        ))}
                    </div>
                </div>
            </ScrollReveal>

            {/* Objetivos */}
            <ScrollReveal client:visible animation="fade-up">
                <div class="bg-gradient-to-br from-dark-soft to-dark p-10 rounded-[30px] border border-white/5">
                    <h2 class="text-3xl font-bold mb-8 text-white">Objetivos del Diseño</h2>
                    <div class="space-y-6">
                        <div class="flex gap-4">
                            <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary font-bold shrink-0">1</div>
                            <p class="text-gray-400 leading-relaxed"><strong class="text-white">Conversión Inmediata:</strong> El diseño debe guiar al usuario hacia el botón de reserva de forma natural y atractiva.</p>
                        </div>
                        <div class="flex gap-4">
                            <div class="w-10 h-10 rounded-full bg-brand-teal/20 flex items-center justify-center text-brand-teal font-bold shrink-0">2</div>
                            <p class="text-gray-400 leading-relaxed"><strong class="text-white">Autoridad Local:</strong> Transmitir que somos los mejores en lo que hacemos a través de visuales de alta calidad y testimonios.</p>
                        </div>
                        <div class="flex gap-4">
                            <div class="w-10 h-10 rounded-full bg-brand-orange/20 flex items-center justify-center text-brand-orange font-bold shrink-0">3</div>
                            <p class="text-gray-400 leading-relaxed"><strong class="text-white">Adaptabilidad:</strong> Una experiencia premium tanto en desktop como en móvil, donde ocurre la mayoría de nuestras reservas.</p>
                        </div>
                    </div>
                </div>
            </ScrollReveal>
        </section>

        <footer class="mt-24 pt-12 border-t border-white/10 text-center text-gray-500 text-sm">
            <p>© 2026 Vamos Jacó Tours — Guide for Creative Teams</p>
        </footer>
    </main>
</Layout>

<style>
    main {
        font-family: 'Outfit', 'Poppins', sans-serif;
    }
</style>
