# Vamos Jacó Tours - Production Environment Variables
# Copy this file to .env and fill in your values

# ─── Site Configuration ───
SITE_URL=https://vamosjacotoursdev.com
PUBLIC_URL=https://vamosjacotoursdev.com

# ─── WordPress/WooCommerce (if using) ───
PUBLIC_WP_URL=https://vamosjacotoursdev.com/wp-json
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# ─── Supabase ───
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── TiloPay ───
TILOPAY_API_KEY=
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_API_URL=https://app.tilopay.com/api/v1
TILOPAY_WEBHOOK_SECRET=

# ─── Resend Email ───
RESEND_API_KEY=

# ─── Admin ───
ADMIN_EMAILS=admin@vamosjaco.com
