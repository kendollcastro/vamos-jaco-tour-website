# Vamos Jacó Tours - Production Environment Variables
# Copy this file to .env and fill in your values

# ─── Site Configuration ───
SITE_URL=https://vamosjacotoursdev.com
PUBLIC_URL=https://vamosjacotoursdev.com

# ─── WordPress/WooCommerce (if using) ───
PUBLIC_WP_URL=https://vamosjacotoursdev.com/wp-json
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# ─── Supabase ───
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Maintenance Mode ───
# Set MAINTENANCE_MODE=true to show the /maintenance/ page on all routes
# (API endpoints, webhooks and static assets keep working).
# MAINTENANCE_TOKEN allows access to the site via ?maintenance_token=<value> or
# a "maintenance_token" cookie (optional; leave empty to disable bypass).
MAINTENANCE_MODE=false
MAINTENANCE_TOKEN=

# ─── Resend Email ───
RESEND_API_KEY=

# ─── Admin ───
ADMIN_EMAILS=admin@vamosjaco.com
